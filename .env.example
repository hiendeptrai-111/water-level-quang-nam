# ============ Backend ============
PORT=4000
APP_VERSION=1.0.0

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ============ PostgreSQL ============
# Cách 1: dùng connection string (Neon/Render style — KHUYẾN NGHỊ)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Cách 2: từng biến rời (cho local dev)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=water_level_db
# DB_SSL=true  # bật khi dùng remote DB

# ============ Auth ============
JWT_SECRET=change-this-to-a-long-random-string-in-prod

# ============ Frontend (build-time) ============
VITE_API_URL=http://localhost:4000

# ============ Optional ============
# Tắt scraper trên môi trường ít RAM (Render free 512MB)
# SCRAPE_DISABLED=true
